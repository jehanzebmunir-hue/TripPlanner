NODE_ENV=development
DATABASE_URL="file:./dev.db"
PORT=3001
CLIENT_URL="http://localhost:5173"
# Generate a real random value before any non-local deploy
JWT_SECRET="change-me"

# Self-serve, free — https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=""
# Self-serve, free — https://seatgeek.com/build
SEATGEEK_CLIENT_ID=""
# Paid/metered — https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=""
# Safety cap on google-places calls per day, checked before every call
# (lib/rateLimiter.ts) — 166 = the real free-tier ceiling (Text Search Pro
# SKU's 5,000 calls/month ÷ 30), not a placeholder. Raise only if you've
# deliberately decided to pay $32/1,000 calls past the free allowance.
GOOGLE_PLACES_MAX_CALLS_PER_DAY=166

# Ingestion is demand-driven, not on a background schedule: ensureCityFresh
# (services/ingestion.service.ts) checks these thresholds on read and only
# re-fetches whichever adapters are actually stale for the requested city.
# How long volatile-tier adapters (ticketmaster/seatgeek/open-data) are
# considered fresh before the next request re-fetches, in ms (default: 1 hour)
VOLATILE_REFRESH_MS=3600000
# Same, for the structured-tier adapter (google-places), in ms (default: 24
# hours — matches its real 90-day static decay window far better than a
# flat 6h would).
STRUCTURED_REFRESH_MS=86400000

# Generic transactional-email send endpoint (lib/email.ts) — leave unset in
# dev; the reset email is logged to the console instead. See
# .env.production.example for why this is non-optional in production.
EMAIL_WEBHOOK_URL=""

# Generic exchange-rate endpoint (lib/exchangeRates.ts) — expects a
# normalized {"rate": number} JSON response for ?from=X&to=Y; whichever
# real provider gets chosen will likely need a thin adapter in front of it
# to match this shape. Leave unset in dev — GET /api/exchange-rate returns
# {rate: null} rather than a guessed conversion.
EXCHANGE_RATE_API_URL=""
EXCHANGE_RATE_API_KEY=""
