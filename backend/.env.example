NODE_ENV=development
DATABASE_URL="file:./dev.db"
PORT=3001
CLIENT_URL="http://localhost:5173"
# Generate a real random value before any non-local deploy
JWT_SECRET="change-me"

# Self-serve, free — https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=""
# Safety cap on ticketmaster calls per day (lib/rateLimiter.ts) — 4,500,
# real headroom under Ticketmaster's own confirmed 5,000/day free quota
# (their developer FAQ, 2 req/sec and 5,000/day). Unlike Google Places this
# isn't protecting against a bill -- Ticketmaster is free -- it's protecting
# the key from getting rate-limited under real traffic, since this adapter
# runs for all 159 cities on demand rather than a fixed schedule.
TICKETMASTER_MAX_CALLS_PER_DAY=4500
# Self-serve, free — https://seatgeek.com/build
SEATGEEK_CLIENT_ID=""
# No daily budget guard exists for SeatGeek -- SeatGeek's own terms and rate
# limits couldn't be directly verified (seatgeek.com/api-terms and /build
# both block automated fetching), so no specific number is asserted here
# rather than guessing one. Protected only by reactive retry-on-429
# (lib/httpRetry.ts) until a real, confirmed quota is found.
# Paid/metered — https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=""
# Safety cap on google-places calls per day, checked before every call
# (lib/rateLimiter.ts) — 161 = floor(5,000 free calls/month ÷ 31, the
# longest possible month), not a placeholder — guarantees the free
# allowance can never be exceeded regardless of month length. Real
# worst-case usage today is ~53 calls/day (one per priorityTier city, each
# refetched at most once per 24h), far under this cap. Raise only if you've
# deliberately decided to pay $32/1,000 calls past the free allowance.
GOOGLE_PLACES_MAX_CALLS_PER_DAY=161

# Ingestion is demand-driven, not on a background schedule: ensureCityFresh
# (services/ingestion.service.ts) checks these thresholds on read and only
# re-fetches whichever adapters are actually stale for the requested city.
# How long volatile-tier adapters (ticketmaster/seatgeek/open-data) are
# considered fresh before the next request re-fetches, in ms (default: 1 hour)
VOLATILE_REFRESH_MS=3600000
# Same, for the structured-tier adapter (google-places), in ms (default: 24
# hours — matches its real 90-day static decay window far better than a
# flat 6h would).
STRUCTURED_REFRESH_MS=86400000

# Real Resend integration (lib/email.ts) — takes priority over
# EMAIL_WEBHOOK_URL below if both are set. This is the one actually live in
# production. Without a verified sending domain in your Resend account
# (Domains tab), Resend's sandbox sender only delivers to the account
# owner's own registered email, not to a real third-party user -- a real,
# documented Resend limitation, not a bug here.
RESEND_API_KEY=""
# Optional -- the "from" address for RESEND_API_KEY sends. Defaults to
# Resend's own sandbox sender if unset.
EMAIL_FROM=""
# Generic transactional-email send endpoint (lib/email.ts) — a fallback for
# any other provider if RESEND_API_KEY isn't set. Leave both unset in dev;
# the reset email is logged to the console instead. See
# .env.production.example for why this is non-optional in production.
EMAIL_WEBHOOK_URL=""

# Generic exchange-rate endpoint (lib/exchangeRates.ts) — expects a
# normalized {"rate": number} JSON response for ?from=X&to=Y; whichever
# real provider gets chosen will likely need a thin adapter in front of it
# to match this shape. Leave unset in dev — GET /api/exchange-rate returns
# {rate: null} rather than a guessed conversion.
EXCHANGE_RATE_API_URL=""
EXCHANGE_RATE_API_KEY=""

# Affiliate tracking on real booking links (lib/affiliateLinks.ts) — off by
# default, exactly like every other optional integration here: leave both
# unset for a given source and its bookingRef URLs pass through completely
# unchanged. Once a real partnership exists, set BOTH the real query
# parameter name that partner's tracking link expects and your real
# partner/affiliate ID; no code changes needed. Verified live which real
# domains each adapter's bookingRef actually resolves to before wiring
# this — Ticketmaster's own Discovery API surfaces sibling brands
# (Universe, TicketWeb) alongside ticketmaster.com itself, so
# AFFILIATE_ID_TICKETMASTER covers all three, not just the one domain.
AFFILIATE_PARAM_TICKETMASTER=""
AFFILIATE_ID_TICKETMASTER=""
AFFILIATE_PARAM_SEATGEEK=""
AFFILIATE_ID_SEATGEEK=""
# These four don't have a live adapter yet — only some real seed.ts entries
# link to citypass.com/opentable.com directly. Still real infrastructure,
# not a placeholder: set these once a real affiliate relationship exists
# and every matching seed link picks up tracking with no code change.
AFFILIATE_PARAM_CITYPASS=""
AFFILIATE_ID_CITYPASS=""
AFFILIATE_PARAM_OPENTABLE=""
AFFILIATE_ID_OPENTABLE=""
AFFILIATE_PARAM_VIATOR=""
AFFILIATE_ID_VIATOR=""
AFFILIATE_PARAM_GETYOURGUIDE=""
AFFILIATE_ID_GETYOURGUIDE=""
AFFILIATE_PARAM_BOOKING=""
AFFILIATE_ID_BOOKING=""

# Real error tracking (lib/sentry.ts) — off by default, same pattern as
# every other optional integration here. Before this, a real crash only
# ever showed up in a Render server log nobody's watching. Sentry has a
# real free tier (sentry.io) — leave unset in dev/local, nothing reports.
SENTRY_DSN=""
