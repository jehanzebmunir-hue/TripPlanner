generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Places / Events / Deals store ───────────────────────────────────────────
// One normalized record type for every discoverable thing, differentiated by
// tier and category rather than by separate schemas per content type.

model Place {
  id             String    @id @default(cuid())
  city           String
  category       String
  tier           String
  name           String
  description    String?
  lat            Float?
  lng            Float?
  address        String?
  source         String
  externalId     String?
  lastVerifiedAt DateTime  @default(now())
  expiryAt       DateTime?
  bookingLabel   String?
  bookingRef     String?
  // null = price not verified (the honest default — most seed entries);
  // 0 = confirmed free; >0 = a real, sourced number. No separate currency
  // column here on purpose: currency is already a solved per-city fact
  // (config/localization.ts's getCurrency()), and duplicating it per-place
  // would just create a second place for the data to disagree with itself.
  priceAmount    Float?
  // A real photo URL resolved from the place's own linked Wikidata entry
  // (see lib/wikidata.ts) -- null means no such link exists, or it has no
  // real photo attached, which is most places. Never a stock photo or a
  // guessed image.
  photoUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tripItems     TripItem[]
  confirmations Confirmation[]

  @@unique([city, source, externalId])
  @@index([city, category])
  @@index([city, tier])
}

// Tracks, per city + adapter, whether the last ingest attempt actually
// succeeded — separate from Place data itself. Without this, a rate-limited
// or dead API and a market with genuinely zero events look identical to
// anyone looking at Place rows alone. This is what lets the frontend show
// "event data may be temporarily outdated" instead of silently presenting
// stale or empty results as if they were current.
model AdapterHealth {
  city                String
  adapter             String
  lastAttemptAt       DateTime
  lastSuccessAt       DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)

  @@id([city, adapter])
}

// A persisted, per-day call counter for adapters that hit a metered/paid
// API (currently just google-places). Checked before every call, not just
// logged after — the point is to stop spend before it happens, not to
// report on it afterward. Persisted (not in-memory) so the count survives
// a dev-server restart or, later, a redeploy; works identically on SQLite
// today and Postgres later since it's a plain upsert-and-count, no
// datastore-specific feature involved.
model ApiCallBudget {
  adapter   String
  date      String // YYYY-MM-DD, UTC
  callCount Int    @default(0)

  @@id([adapter, date])
}

// One real fetch per currency pair per UTC day, cached here — not a
// per-request live call. No provider is connected yet (see
// lib/exchangeRates.ts); this table exists so the caching behavior itself
// is real and tested before any real key goes in, same as ApiCallBudget.
model ExchangeRateCache {
  fromCurrency String
  toCurrency   String
  date         String // YYYY-MM-DD, UTC
  rate         Float
  fetchedAt    DateTime @default(now())

  @@id([fromCurrency, toCurrency, date])
}

// Real weather data (lib/weather.ts) for a trip's destination + date range --
// Open-Meteo, free, no key, verified live before building against it. source
// distinguishes a real forecast (trip within its 16-day window) from a
// historical average (older years' real recorded weather for the same
// calendar dates, for a trip too far out to forecast) -- never a guess
// either way. Cached per city+date-range+source rather than fetched on every
// checklist load: forecast entries go stale in hours (a forecast made 10
// days out isn't final), historical entries barely change at all, so each
// checks staleness against its own real refresh window (see weather.ts).
model WeatherCache {
  citySlug          String
  startDate         String // YYYY-MM-DD
  endDate           String // YYYY-MM-DD
  source            String // "forecast" | "historical-average"
  avgHighC          Float
  avgLowC           Float
  rainChancePercent Float
  fetchedAt         DateTime @default(now())

  @@id([citySlug, startDate, endDate, source])
}

// A place resolved on demand via OpenStreetMap's Nominatim geocoder when a
// requested city isn't in the curated config/cities.ts registry -- cached
// here permanently so the same real place is only ever geocoded once, not
// re-fetched from Nominatim on every later search or ensureCityFresh call.
// slug is the primary key (not a separate cuid) since it's also the exact
// string every Place/Trip/TripLeg row keys off of for this city -- see
// services/cityResolution.service.ts.
model ResolvedCity {
  slug      String   @id
  name      String
  country   String
  lat       Float
  lng       Float
  timezone  String
  currency  String
  // Every raw search query (lowercased) that has ever resolved to this row.
  // Necessary because Nominatim's own "name" field is the local name, not
  // necessarily what an English-speaking traveler types -- caught live:
  // searching "Bruges" resolves and caches a row named "Brugge, Belgium"
  // (its real Dutch name), and a plain name-contains lookup on a *second*
  // search for "Bruges" would silently miss its own cached result. Matching
  // against aliases too means the exact query that found it once will find
  // it again, without re-geocoding.
  aliases   String[] @default([])
  createdAt DateTime @default(now())
}

model Confirmation {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  vote      String
  createdAt DateTime @default(now())
}

// ── Accounts ─────────────────────────────────────────────────────────────────
// Optional — a trip can be planned and shared via URL with no account at all.
// Logging in only attaches trips to a "My Trips" list for cross-device access.

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  createdAt    DateTime             @default(now())
  trips        Trip[]
  resetTokens  PasswordResetToken[]
}

// Deleting a User cascades this (a stale outstanding reset link becomes
// meaningless once the account is gone) but deliberately does NOT cascade
// Trip — Trip.userId is onDelete: SetNull below, so account deletion erases
// the account's identifying data (email, password hash) while a user's trip
// *plans* survive as ordinary anonymous trips, same as if they'd never
// logged in. Trip content (a city, some dates, a few place names) isn't
// identifying on its own, and destroying someone's actual travel plans as a
// side effect of deleting login credentials would be a worse outcome than
// what it's meant to protect against.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ── Trips ────────────────────────────────────────────────────────────────────

model Trip {
  id          String     @id @default(cuid())
  // The primary/first city -- unchanged meaning, every existing trip and
  // every single-city code path keeps working with zero changes. Additional
  // cities are purely additive via TripLeg below, not a replacement for
  // this.
  city        String
  destination String
  startDate   DateTime?
  endDate     DateTime?
  interests   String     @default("[]")
  // Set once at trip creation (SetupScreen), same as city/dates -- no edit
  // flow exists for those either. null = traveler didn't pick one (or this
  // trip predates the feature); the UI shows native prices only in that
  // case, same as it always has, rather than guessing a currency.
  homeCurrency String?
  // Optional second (and third, ...) permission on top of this trip's own
  // id -- the plain /trip/:id link is view-only; only a link carrying this
  // token can mutate the trip. Generated once at creation, never rotated
  // (no edit-permission-revocation flow exists yet -- see README).
  editToken   String     @unique @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       TripItem[]
  legs        TripLeg[]
}

// Additional cities beyond Trip's own primary city/destination/dates --
// multi-city trips ("Paris then Rome") without touching how a single-city
// trip works at all. Which leg a given TripItem belongs to is inferred from
// its Place's own city matched against a leg's city, not stored redundantly
// -- see trips.service.ts's addTripItem.
model TripLeg {
  id          String     @id @default(cuid())
  tripId      String
  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city        String
  destination String
  startDate   DateTime?
  endDate     DateTime?
  order       Int        @default(0)
  items       TripItem[]

  @@index([tripId])
}

model TripItem {
  id       String   @id @default(cuid())
  tripId   String
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  placeId  String
  place    Place    @relation(fields: [placeId], references: [id])
  // null = belongs to the trip's own primary city (existing behavior,
  // unchanged); set = belongs to this specific additional leg. dayIndex
  // below is always relative to whichever of these two date ranges applies
  // -- see trips.service.ts/trips.routes.ts for how that's resolved.
  legId    String?
  leg      TripLeg? @relation(fields: [legId], references: [id], onDelete: SetNull)
  dayIndex Int      @default(1)
  addedAt  DateTime @default(now())

  @@unique([tripId, placeId])
}

// ── Checklist ────────────────────────────────────────────────────────────────
// Static, templated content — deliberately outside the freshness pipeline,
// since none of it needs live verification.

model ChecklistTemplateItem {
  id    String @id @default(cuid())
  phase String
  label String
  order Int    @default(0)
}

model ChecklistCheck {
  id      String  @id @default(cuid())
  tripId  String
  itemKey String
  checked Boolean @default(true)

  @@unique([tripId, itemKey])
}

// ── Analytics ────────────────────────────────────────────────────────────────
// Self-hosted, aggregate-only, no third-party vendor and no PII -- exists
// because this app shipped a large number of features with zero way to tell
// which ones anyone actually uses. Deliberately minimal: an event name, an
// optional real context value (a city slug or category, never anything
// identifying a person), and when. No IP, no user agent, no session/device
// id, no account linkage even for logged-in users. See PRIVACY.md.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  context   String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
